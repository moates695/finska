{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest",
        "autoIncrement": true
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest",
        "autoIncrement": true
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest",
        "autoIncrement": true
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest",
        "autoIncrement": true
      }
    },
    "store": {
      "channel": "internal",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "image": "latest",
        "autoIncrement": true
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest",
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "store": {
      "ios": {
        "appleId": "kandmoates1@gmail.com"
      }
    }
  }
}
